{
  "name": "jinko",
  "description": "Search flights, hotels and car rentals, book trips, and manage bookings with the Jinko Travel API. Connects to the Jinko MCP server for live pricing, trip management, cancellation and payment.",
  "version": "3.1.5",
  "author": {
    "name": "Jinko",
    "url": "https://gojinko.com"
  },
  "homepage": "https://gojinko.com",
  "repository": "https://github.com/jinkoso/jinko-agent-plugins",
  "license": "MIT",
  "keywords": [
    "travel",
    "flights",
    "hotels",
    "car-rental",
    "booking",
    "mcp"
  ],
  "mcpServers": {
    "jinko": {
      "type": "http",
      "url": "${JINKO_MCP_URL:-https://mcp.builders.gojinko.com/mcp}",
      "headers": {
        "Authorization": "Bearer ${JINKO_API_KEY}"
      }
    }
  }
}
